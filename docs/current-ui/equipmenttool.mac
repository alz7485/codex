Var !!projectName 'Demo'
Var !!equipmentValue 'P-101'
Kill !!equipmenttool
-- Generated by E3D PML Form Designer
-- Target: E3D 4.0 (runtime compatibility not yet verified)
Setup Form !!equipmenttool Dialog Dock Right
  Title 'Equipment Tool'
  Paragraph .heading At X 2 Y 1 Text 'Equipment settings' Width 35
  Text .equipmentName At X 2 Y 3 'Name' Width 28 Is String
  Option _equipmentType At X 2 Y 5 'Type' Call '$$_equipmentType'
  Var List _equipmentType Pairs
  'Pump' |$p 'Pump selected'|
  'Tank' |$p 'Tank selected'|
  'Vessel' |$p 'Vessel selected'|
  Exit
  Toggle .enabled At X 2 Y 7 'Enabled'
  List .results At X 2 Y 9 'Results' Single Width 40 Height 5
  Button .run At X 2 Y 16 'Apply' Call '!this.applySettings()' Width 14
Exit

Show !!equipmenttool

!!equipmenttool.DEFAULT()

Define Method .DEFAULT()
  !this.equipmentName.val = 'P-101'
!!equipmenttool.equipmentName.VAL = !!equipmentValue
Endmethod

Define Method .applySettings()
  -- Add E3D logic here
  $p 'Apply clicked'
Endmethod

Define Method .equipmenttool()
  !choices = Object Array()
  !choices[1] = 'P-101'
  !choices[2] = 'T-201'
  !this.results.dtext = !choices
  !this.DEFAULT()
Endmethod
