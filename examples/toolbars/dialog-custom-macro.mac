Kill !!actionrow

Setup Form !!actionrow Size 70 22 Dialog
  Title 'Custom and macro buttons'
  Frame .tools1 'Tools'
    Button .tools1Button1 At X 1 Y 1 'Run' Call '!this.on_tools1Button1()' Width 12
    Button .tools1Button2 At X 14 Y 1 'Macro' Call '!this.macro_tools1Button2()' Width 12
  Exit
Exit

Show !!actionrow

Define Method .macro_tools1Button2()
  $M "C:/E3D/macros/example.mac"
Endmethod

Define Method .on_tools1Button1()
$p Replace this sample with your processing.
Endmethod
