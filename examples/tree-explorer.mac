Kill !!EquipmentTool
-- Generated by E3D PML Form Designer
-- Target: E3D 4.0 (runtime compatibility not yet verified)
Setup Form !!EquipmentTool Size 64 21 Dialog
  Title '機器ツール'
  Frame .SearchGroup '検索条件'
    Frame .BasicGroup '基本条件'
      Text .SearchText At X 1 Y 2 '機器名' Width 20 Is String
      Button .RunSearch At X 1 Y 5 '検索する' Width 15
    Exit
    Toggle .Visible At X 1 Y 12 '表示する'
  Exit
  Frame .ResultTabs Tabset At X 32 Y 2 '結果' Width 28
    Frame .ListPage '一覧'
      List .Results At X 1 Y 2 '検索結果' Single Width 25 Height 8
    Exit
    Frame .ViewPage 'ビュー'
      View .ModelView At X 1 Y 2 Volume
        Width 25 Height 10
      Exit
    Exit
  Exit
Exit

Show !!EquipmentTool

Define Method .EquipmentTool()
  !this.populate_Results()
  !this.DEFAULT()
Endmethod

Define Method .populate_Results()
  !HEAD = Array()
  !HEAD[1] = '機器名'
  !HEAD[2] = '種別'
  !THIS.Results.setheadings(!HEAD)
  !ROWS = Array()
  !ROWS[1] = Array()
  !ROWS[1][1] = 'P-101'
  !ROWS[1][2] = 'ポンプ'
  !ROWS[2] = Array()
  !ROWS[2][1] = 'T-201'
  !ROWS[2][2] = 'タンク'
  !THIS.Results.setrows(!ROWS)
Endmethod

Define Method .DEFAULT()
  !this.SearchText.val = 'P-101'
  !this.Visible.val = TRUE
Endmethod
