VAR !!buttonFlag ''
kill !!macroLauncher
-- Generated by E3D PML Form Designer
-- Target: E3D 4.0 (runtime compatibility not yet verified)
setup form !!macroLauncher DIALOG DOCK RIGHT
  title 'Shared Macro'
  BUTTON .buttonA AT X 2 Y 2 'Button A' CALL '!this.macro_buttonA()' WIDTH 20
  BUTTON .buttonB AT X 2 Y 4 'Button B' CALL '!this.macro_buttonB()' WIDTH 20
exit

SHOW !!macroLauncher

define method .macroLauncher()
endmethod

DEFINE METHOD .DEFAULT()
  -- TODO: add default logic
ENDMETHOD

define method .macro_buttonA()
  !!buttonFlag = 'A'
  $M "C:/Macros/code1.txt"
endmethod

define method .macro_buttonB()
  !!buttonFlag = 'B'
  $M "C:/Macros/code1.txt"
endmethod
