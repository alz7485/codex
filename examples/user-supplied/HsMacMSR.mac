kill !!HsMacMSR
setup form !!HsMacMSR $$DIALOG DOCK RIGHT
TITLE |<Mesure>|
PARAGRAPH .PARAGRAPHxA0001 AT X 1.0 Y 1.0 TEXT |距離| WIDTH 8.0
PARAGRAPH .PARAGRAPHxA0002 AT X 0.0 Y 1.9 TEXT |Xの距離| WIDTH 8.0
PARAGRAPH .PARAGRAPHxA0003 AT X 0.0 Y 2.8 TEXT |Yの距離| WIDTH 8.0
PARAGRAPH .PARAGRAPHxA0004 AT X 0.0 Y 3.7 TEXT |Zの距離| WIDTH 8.0
PARAGRAPH .PARAGRAPHxA0005 AT X 1.0 Y 4.6 TEXT |角度| WIDTH 8.0
PARAGRAPH .PARAGRAPHxA0006 AT X 0.4 Y 5.5 TEXT |P1座標| WIDTH 8.0
PARAGRAPH .PARAGRAPHxA0007 AT X 0.4 Y 6.4 TEXT |P2座標| WIDTH 8.0
TEXT .TEXTxA0001 AT X 7.0 Y 1.0 || CALL || WIDTH 30.0 IS STRING
TEXT .TEXTxA0002 AT X 7.0 Y 1.9 || CALL || WIDTH 30.0 IS STRING
TEXT .TEXTxA0003 AT X 7.0 Y 2.8 || CALL || WIDTH 30.0 IS STRING
TEXT .TEXTxA0004 AT X 7.0 Y 3.7 || CALL || WIDTH 30.0 IS STRING
TEXT .TEXTxA0005 AT X 7.0 Y 4.6 || CALL || WIDTH 30.0 IS STRING
TEXT .TEXTxA0006 AT X 7.0 Y 5.5 || CALL || WIDTH 30.0 IS STRING
TEXT .TEXTxA0007 AT X 7.0 Y 6.4 || CALL || WIDTH 30.0 IS STRING
BUTTON .BUTTONxA0001 AT X 0.0 Y 0.0 BACKGROUND 48 |計測| CALL |$M /%PDMSUSER%/SUB/MSRsub1.mac| WIDTH 4.0
BUTTON .BUTTONxA0002 AT X 6.0 Y 0.0 BACKGROUND 168 |結果| CALL |$M /%PDMSUSER%/SUB/MSRsub2.mac| WIDTH 4.0
BUTTON .BUTTONxA0003 AT X 25.0 Y 0.0 |▲| CALL |$M /%PDMSUSER%/SUB/MSRsub3.mac| WIDTH 1.2
BUTTON .BUTTONxA0004 AT X 27.0 Y 0.0 |▼| CALL |$M /%PDMSUSER%/SUB/MSRsub4.mac| WIDTH 1.2
BUTTON .BUTTONxA0005 AT X 33.0 Y 0.0 |PIN消| CALL |PIN1 OFF PIN2 OFF| WIDTH 4.0
TOGGLE .TOGGLExA0001 AT X 12.0 Y 0.0 |小数点| CALL ||

OPTION _OPTIONxA0001 AT X 19.0 Y 0.0 || CALL |$$_OPTIONxA0001| WIDTH 2.0
VAR LIST _OPTIONxA0001 PAIRS
|0| |!!DCP = 'D0'|
|1| |!!DCP = 'D1'|
|2| |!!DCP = 'D2'|
|3| |!!DCP = 'D3'|
|4| |!!DCP = 'D4'|
|5| |!!DCP = 'D5'|
|6| |!!DCP = 'D6'|
|7| |!!DCP = 'D7'|
|8| |!!DCP = 'D8'|
|9| |!!DCP = 'D9'|
EXIT

EXIT

SHOW !!HsMacMSR

DEFINE METHOD .DEFAULT()
!THIS.OPTIONxA0001.VAL = 5
!THIS.TOGGLExA0001.VAL = TRUE
!!DCP = 'D4'
ENDMETHOD
