kill !!featuredemo
-- Generated by E3D PML Form Designer
-- Target: E3D 4.0 (runtime compatibility not yet verified)
setup form !!featuredemo DIALOG DOCK RIGHT
  title 'Additional gadgets'
  menu .modelPopup POPUP
  exit
  PARAGRAPH .pumpImage AT X 2 Y 1 PIXMAP WIDTH 180 HEIGHT 130
  OPTION .pumpChoice AT X 24 Y 1 'Pump' PIXMAP WIDTH 180 HEIGHT 130
  TEXTPANE .notes 'Notes' FIXCHARS AT X 2 Y 8 WIDTH 30 HEIGHT 7
  SELECTOR .owners AT X 36 Y 8 'Database owners' SINGLE WIDTH 30 HEIGHT 7 DATABASE OWNERS
  VIEW .model AT X 2 Y 16 VOLUME
    WIDTH 30 HEIGHT 4
  EXIT
  BUTTON .accept AT X 38 Y 17 'OK' OK WIDTH 12
  BUTTON .cancel AT X 53 Y 17 'Cancel' CANCEL WIDTH 12
exit

SHOW !!featuredemo

define method .featuredemo()
  !this.modelPopup.Add('CALLBACK', 'Query current element', 'Q ATT')
  !this.modelPopup.Add('CALLBACK', 'Query members', 'Q MEM')
  !this.initcall = |$p 'Form shown'|
  !this.okcall = 'SAVEWORK'
  !this.cancelcall = |$p 'Cancelled'|
  !this.pumpImage.AddPixmap('examples/assets/red.png')
  !choices = object ARRAY()
  !choices[1] = 'examples/assets/red.png'
  !choices[2] = 'examples/assets/yellow.png'
  !this.pumpChoice.dtext = !choices
  !values = object ARRAY()
  !values[1] = 'P-101'
  !values[2] = 'P-102'
  !this.pumpChoice.rtext = !values
  !paneLines = ARRAY()
  !paneLines[1] = 'Name    Type'
  !paneLines[2] = 'P-101   Pump'
  !paneLines[3] = '  Indented note'
  !this.notes.val = !paneLines
  !this.model.SetPopup(!this.modelPopup)
endmethod

DEFINE METHOD .DEFAULT()
  -- TODO: add default logic
ENDMETHOD
