    "extra_methods": [
      {
        "name": "processSelector1",
        "signature": "()",
        "body": "!selectedNames = object ARRAY()\ndo !selected selector !this.targets\n  !selectedNames.append(!selected)\nenddo\nif (!selectedNames.size() eq 0) then\n  $p Select at least one database element.\n  return\nendif\n!processedCount = 0\ndo !selected values !selectedNames\n  !element = object DBREF(!selected)\n  if (BADREF(!element)) then\n    $p Invalid database reference: $!selected\n  else\n    !this.processSelector1Element(!element)\n    !processedCount = !processedCount + 1\n  endif\nenddo\n$p Processed count: $!processedCount"
      },
      {
        "name": "processSelector1Element",
        "signature": "(!element is DBREF)",
        "body": "import 'MyDataAddin'\nhandle (1000,0)\n  -- Assembly already loaded\nendhandle\nusing namespace 'Aveva.Core.Presentation.MyDataAddin'\n!myData = object PMLMyData()\n!name = !element.name\n!myData.AddElement(!name)\n$p Added to My Data: $!name"
      }
