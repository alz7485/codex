kill !!tableDemo
-- Generated by E3D PML Form Designer
-- Target: E3D 4.0 (runtime compatibility not yet verified)
setup form !!tableDemo DIALOG DOCK RIGHT
  title 'Multi-column LIST'
  list .equipment AT X 2 Y 2 'Equipment' SINGLE WIDTH 50 HEIGHT 8
exit

SHOW !!tableDemo

define method .tableDemo()
  !this.fillEquipment()
endmethod

define method .fillEquipment()
  !HEAD = ARRAY()
  !HEAD[1] = '番号'
  !HEAD[2] = '名称'
  !HEAD[3] = '種類'
  !THIS.equipment.setheadings(!HEAD)
  !ROWS = ARRAY()
  !ROWS[1] = ARRAY()
  !ROWS[1][1] = 'P-101'
  !ROWS[1][2] = 'Pump 101'
  !ROWS[1][3] = 'Pump'
  !ROWS[2] = ARRAY()
  !ROWS[2][1] = 'T-201'
  !ROWS[2][2] = 'Tank 201'
  !ROWS[2][3] = 'Tank'
  !THIS.equipment.setrows(!ROWS)
endmethod

DEFINE METHOD .DEFAULT()
  -- TODO: add default logic
ENDMETHOD
