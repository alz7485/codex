Kill !!netMembersDemo

Setup Form !!netMembersDemo Size 70 22 Dialog
  Title 'CE Members'
  Import 'GridControl'
  Handle (1000,0)
    -- Assembly already loaded
  Endhandle
  Using Namespace 'Aveva.Core.Presentation'
  Member .netGrid1Control Is NetGridControl
  Container .netGrid1 At X 2 Y 1 Pmlnetcontrol Width 36 Height 9
Exit

Show !!netMembersDemo

Define Method .netMembersDemo()
  Using Namespace 'Aveva.Core.Presentation'
  !this.netGrid1Control = Object NetGridControl()
  !this.netGrid1.Control = !this.netGrid1Control.handle()
!netHeadings = object ARRAY()
!netHeadings[1] = 'Name'
!netHeadings[2] = 'Type'
!netRows = object ARRAY()
if (BADREF(!!CE)) then
  $p Select a database element first.
else
  do !netElement values !!CE.members
    !netRow = object ARRAY()
    !netRow[1] = !netElement.name
    !netRow[2] = !netElement.type
    !netRows.append(!netRow)
  enddo
endif
!netSource = object NetDataSource('netGrid1', !netHeadings, !netRows)
!this.netGrid1Control.BindToDataSource(!netSource)
!this.netGrid1Control.EditableGrid(FALSE)
!this.netGrid1Control.SingleRowSelection(FALSE)
Endmethod
