Kill !!gadgetDemo
-- Generated by E3D PML Form Designer
-- Target: E3D 4.0 (runtime compatibility not yet verified)
Setup Form !!gadgetDemo Dialog Dock Right
  Title 'Additional gadgets'
  Frame .types 'Equipment type'
    Rtoggle .pump 'Pump' At X 1 Y 1 States '' 'PUMP'
    Rtoggle .tank 'Tank' At X 1 Y 3 States '' 'TANK'
  Exit
  Slider .level At X 28 Y 1 Horizontal Range 0 100 Step 5 VAL 35 Width 28
  List .equipment At X 28 Y 4 'Equipment' Multiple Width 28 Height 5
  Combo .choice 'Choice' At X 28 Y 10 Scroll 20 Width 28
  View .model At X 2 Y 9 Volume
    Width 22 Height 8 Aspect 1.5
    LIMITS AUTO
  ISOMETRIC 3
  Exit
  View .commands At X 28 Y 13 Alpha
    Width 28 Height 6
    CHANNEL Requests
    CHANNEL Commands
  Exit
  Container .external At X 2 Y 20 Pmlnetcontrol Width 22 Height 5
  -- Set Control handle in DEFAULT or configure assembly / namespace / type
Exit

Show !!gadgetDemo

Define Method .DEFAULT()
  !this.level.val = 35
Endmethod

Define Method .levelChanged(!gad Is GADGET, !event Is String)
  q var !gad.val
  q var !event
Endmethod

Define Method .gadgetDemo()
  !this.level.callback = '!this.levelChanged('
  !choices = Object Array()
  !choices[1] = 'Pump 101'
  !choices[2] = 'Tank 201'
  !this.equipment.dtext = !choices
  !values = Object Array()
  !values[1] = '/P-101'
  !values[2] = '/T-201'
  !this.equipment.rtext = !values
  !choices = Object Array()
  !choices[1] = 'Pump'
  !choices[2] = 'Tank'
  !this.choice.dtext = !choices
  !values = Object Array()
  !values[1] = 'PUMP'
  !values[2] = 'TANK'
  !this.choice.rtext = !values
  !this.DEFAULT()
Endmethod
